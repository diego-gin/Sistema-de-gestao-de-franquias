<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="franquiasPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.franquias.api.models.Usuario</class>
        <class>com.franquias.api.models.Franqueadora</class>
        <class>com.franquias.api.models.Franqueado</class>
        <class>com.franquias.api.models.UnidadeFranqueada</class>
        <class>com.franquias.api.models.Categoria</class>
        <class>com.franquias.api.models.ProdutoServico</class>
        <class>com.franquias.api.models.Fornecedor</class>
        <class>com.franquias.api.models.Estoque</class>
        <class>com.franquias.api.models.MovimentacaoEstoque</class>
        <class>com.franquias.api.models.Venda</class>
        <class>com.franquias.api.models.ItemVenda</class>
        <class>com.franquias.api.models.Royalty</class>
        <class>com.franquias.api.models.ChamadoSuporte</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:file:./data/franquias;AUTO_SERVER=TRUE"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!--
                IMPORTANTE: o schema (tabelas) é criado e versionado pelo Flyway
                (ver src/main/resources/db/migration). O Hibernate apenas VALIDA
                se as entidades batem com as tabelas existentes — ele nunca
                altera o schema sozinho. Isso evita divergência entre o que o
                relatório documenta (migrations) e o que realmente existe no banco.
            -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!--
                Converte automaticamente nomes de campos Java em camelCase
                (ex: dataAbertura) para snake_case no banco (ex: data_abertura),
                que é o padrão usado nas migrations do Flyway.
            -->
            <property name="hibernate.physical_naming_strategy"
                      value="org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
